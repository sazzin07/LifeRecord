# MariaDB / MySQL configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=liferecord
DATABASE_USER=root
DATABASE_PASSWORD=

# Authentication
JWT_SECRET=<YOUR_JWT_SECRET>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial admin/owner account (created on first startup if no user exists)
ADMIN_EMAIL=<YOUR_ADMIN_EMAIL>
ADMIN_PASSWORD=<YOUR_ADMIN_PASSWORD>

# Email delivery (SMTP)
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true
SMTP_HOST=<YOUR_SMTP_HOST>
SMTP_PORT=587
SMTP_USERNAME=<YOUR_SMTP_USERNAME>
SMTP_PASSWORD=<YOUR_SMTP_PASSWORD>
SMTP_USE_TLS=true
SMTP_FROM_NAME=Life Record
SMTP_FROM_EMAIL=<YOUR_FROM_EMAIL>

# Frontend URL used in password-reset links
FRONTEND_URL=http://localhost:3000

# Rate limiting (requests per window)
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX_ATTEMPTS=10

# AI (Google Gemini) — server-side only, never exposed to the frontend
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
# Default is Flash Lite because it has the highest free-tier quota.
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated fallback models tried in order on quota/rate-limit errors.
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=25
GEMINI_FALLBACK_DELAY_SECONDS=0.5

# Application
OWNER_NAME=Sá
CORS_ORIGINS=http://localhost:3000
# Comma-separated list of allowed Host headers (e.g. localhost, liferecord.example.com).
# Leave empty to disable host validation (development only).
ALLOWED_HOSTS=

# Local file storage for progress photos
STORAGE_DIR=./storage

# File upload limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_PHOTO_EXTENSIONS=jpg,jpeg,png,webp
