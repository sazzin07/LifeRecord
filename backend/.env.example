# MariaDB / MySQL configuration
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=liferecord
DATABASE_USER=root
DATABASE_PASSWORD=

# Authentication
JWT_SECRET=<YOUR_JWT_SECRET>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Server-side sessions (defaults shown): idle lifetime follows the refresh token; a session never outlives SESSION_MAX_DAYS
# SESSION_IDLE_DAYS=7
# SESSION_MAX_DAYS=30
# Sign-in guessing limits per account (defaults shown); verification-code tries per address per day
# LOGIN_LOCK_MAX_ATTEMPTS=20
# LOGIN_LOCK_FAMILIAR_MAX_ATTEMPTS=100
# LOGIN_LOCK_WINDOW_SECONDS=900
# VERIFY_LOCK_MAX_ATTEMPTS=30
# SESSION_MAX_PER_USER=20
# Refresh tokens are used once: the one just replaced works for REFRESH_GRACE_SECONDS; a repeat carrying the same key, for REFRESH_RETRY_HOURS
# REFRESH_GRACE_SECONDS=60
# REFRESH_RETRY_HOURS=24
# Check new passwords against known data breaches (a call to a third party, so it is a switch). Sends only a 5-character hash
# prefix and fails open. ON for the owner's installation since 2026-11-03; remove or set 0 to turn it off.
PASSWORD_BREACH_CHECK=1
# PASSWORD_BREACH_MIN_COUNT=1
# Two-step sign-in. Passkeys / security keys need no provider. The "relying party" is the site's own host name, taken from the
# page's address (it must be one of CORS_ORIGINS or FRONTEND_URL); set these only to pin it. Changing the host name later makes
# every registered passkey unusable, so decide before people register them.
# WEBAUTHN_RP_ID=liferecord.example.com
# WEBAUTHN_ORIGINS=https://liferecord.example.com
# Text-message codes need an SMS provider (Twilio). Without one the option is shown as "not set up on this server".
#   SMS_PROVIDER=twilio  TWILIO_ACCOUNT_SID=AC...  TWILIO_FROM=+351...   (or TWILIO_MESSAGING_SERVICE_SID=MG...)
#   TWILIO_AUTH_TOKEN is a secret: python local_secrets.py set TWILIO_AUTH_TOKEN
#   Or Twilio Verify (no sender number needed; Twilio makes, sends and checks the code):
#   SMS_PROVIDER=twilio  TWILIO_ACCOUNT_SID=AC...  TWILIO_VERIFY_SERVICE_SID=VA...
# SMS_MAX_PER_HOUR=60            # all accounts together: a cap on what a flood could cost
# Serve /docs and /openapi.json (development only)
# API_DOCS=1

# Initial admin/owner account (created on first startup if no user exists)
ADMIN_EMAIL=<YOUR_ADMIN_EMAIL>
ADMIN_PASSWORD=<YOUR_ADMIN_PASSWORD>

# Email delivery. Recommended: SendGrid's SMTP relay (keep SMTP_PASSWORD, which is a SendGrid API key with
# Mail Send permission, in the encrypted store: python local_secrets.py set SMTP_PASSWORD)
#   EMAIL_PROVIDER=smtp  SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USERNAME=apikey
#   SMTP_FROM_EMAIL=<a sender verified in SendGrid: Settings > Sender Authentication>
EMAIL_PROVIDER=smtp
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true
SMTP_HOST=<YOUR_SMTP_HOST>
SMTP_PORT=587
SMTP_USERNAME=<YOUR_SMTP_USERNAME>
SMTP_PASSWORD=<YOUR_SMTP_PASSWORD>
SMTP_USE_TLS=true
SMTP_FROM_NAME=Life Record
SMTP_FROM_EMAIL=<YOUR_FROM_EMAIL>

# Frontend URL used in password-reset links
FRONTEND_URL=http://localhost:3000

# Rate limiting (requests per window)
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX_ATTEMPTS=10

# AI chat provider: opencode (OpenCode Go, default) or gemini. Server-side only, never exposed to the frontend.
AI_PROVIDER=opencode
# OpenCode Go is a subscription product with its own endpoint; prepaid Console credits use a different one and
# answer 402 "Insufficient account funds" when that balance is empty.
OPENCODE_API_KEY=<YOUR_OPENCODE_API_KEY>
OPENCODE_BASE_URL=https://opencode.ai/inference/go
OPENCODE_MODEL=gpt-6-luna
OPENCODE_TIMEOUT_SECONDS=60

# Gemini: voice transcription and receipt scanning (and chat when AI_PROVIDER=gemini)
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
# Default is Flash Lite because it has the highest free-tier quota.
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated fallback models tried in order on quota/rate-limit errors.
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=25
GEMINI_FALLBACK_DELAY_SECONDS=0.5

# Application
OWNER_NAME=Sá
CORS_ORIGINS=http://localhost:3000
# Comma-separated list of allowed Host headers (e.g. localhost, liferecord.example.com).
# Leave empty to disable host validation (development only).
ALLOWED_HOSTS=

# Local file storage for progress photos
STORAGE_DIR=./storage

# File upload limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_PHOTO_EXTENSIONS=jpg,jpeg,png,webp

# Email delivery for scheduled reports and recipient verification codes (SendGrid, HTTPS API).
# SENDGRID_FROM_EMAIL must be a sender address (or domain) verified in your SendGrid account.
SENDGRID_API_KEY=<YOUR_SENDGRID_API_KEY>
SENDGRID_FROM_EMAIL=<YOUR_VERIFIED_SENDER_EMAIL>
# Set to true if your SendGrid account uses EU data residency (EU-pinned subuser).
SENDGRID_EU=false

# Scheduled AI tasks
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
SCHEDULED_RUN_TIMEOUT_SECONDS=120
