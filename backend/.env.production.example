# Production environment template for LifeRecord backend.
# Copy this file to .env.production, fill in real values, and never commit it.

# MariaDB / MySQL configuration
DATABASE_HOST=your-db-host
DATABASE_PORT=3306
DATABASE_NAME=liferecord
DATABASE_USER=liferecord
DATABASE_PASSWORD=<STRONG_RANDOM_PASSWORD>

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=<CHANGE_ME_TO_A_CRYPTographically_RANDOM_SECRET_64_CHARS_OR_MORE>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Server-side sessions (defaults shown). A restart signs everyone out; run one API process.
# SESSION_IDLE_DAYS=7
# SESSION_MAX_DAYS=30
# Sign-in guessing limits per account (defaults shown); verification-code tries per address per day
# LOGIN_LOCK_MAX_ATTEMPTS=20
# LOGIN_LOCK_FAMILIAR_MAX_ATTEMPTS=100
# LOGIN_LOCK_WINDOW_SECONDS=900
# VERIFY_LOCK_MAX_ATTEMPTS=30
# SESSION_MAX_PER_USER=20
# REFRESH_GRACE_SECONDS=60
# REFRESH_RETRY_HOURS=24
# Two-step sign-in stores its secrets encrypted under UPLOAD_ENCRYPTION_KEY: set it, and keep a copy.
# Leave API_DOCS unset in production: /docs and /openapi.json list every route.

# Initial admin/owner account (created on first startup if no user exists)
ADMIN_EMAIL=admin@example.com
# Generate with a password manager; at least 16 characters.
ADMIN_PASSWORD=<STRONG_ADMIN_PASSWORD>

# Email delivery through SendGrid's SMTP relay (SMTP_USERNAME is literally "apikey"; SMTP_PASSWORD is a SendGrid
# API key with Mail Send permission; SMTP_FROM_EMAIL must be a sender or domain verified in SendGrid).
EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.sendgrid.net
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_USE_TLS=true
SMTP_FROM_NAME=Life Record
SMTP_FROM_EMAIL=noreply@example.com

# Frontend URL used in password-reset links
FRONTEND_URL=https://liferecord.example.com

# Rate limiting (requests per window)
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX_ATTEMPTS=10

# AI chat provider: opencode (OpenCode Go, default) or gemini. Server-side only, never exposed to the frontend.
AI_PROVIDER=opencode
# OpenCode Go is a subscription product with its own endpoint; prepaid Console credits use a different one and
# answer 402 "Insufficient account funds" when that balance is empty.
OPENCODE_API_KEY=<YOUR_OPENCODE_API_KEY>
OPENCODE_BASE_URL=https://opencode.ai/inference/go
OPENCODE_MODEL=gpt-6-luna
OPENCODE_TIMEOUT_SECONDS=60

# Gemini: voice transcription and receipt scanning (and chat when AI_PROVIDER=gemini)
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=25
GEMINI_FALLBACK_DELAY_SECONDS=0.5

# Application
OWNER_NAME=Owner
# Restrict to the production frontend domain only.
CORS_ORIGINS=https://liferecord.example.com
# Comma-separated list of allowed Host headers.
ALLOWED_HOSTS=liferecord.example.com

# Local file storage for progress photos
STORAGE_DIR=./storage

# File upload limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_PHOTO_EXTENSIONS=jpg,jpeg,png,webp

# Email delivery for scheduled reports and recipient verification codes (SendGrid, HTTPS API).
# SENDGRID_FROM_EMAIL must be a sender address (or domain) verified in your SendGrid account.
SENDGRID_API_KEY=<YOUR_SENDGRID_API_KEY>
SENDGRID_FROM_EMAIL=<YOUR_VERIFIED_SENDER_EMAIL>
# Set to true if your SendGrid account uses EU data residency (EU-pinned subuser).
SENDGRID_EU=false

# Scheduled AI tasks
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
SCHEDULED_RUN_TIMEOUT_SECONDS=120
